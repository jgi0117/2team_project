# Copy this file to .env and replace the credentials for the local MySQL server.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=maintenance_dashboard
DB_USER=root
DB_PASSWORD=change-me
DB_ENABLED=true

# Use 0.0.0.0 only when the dashboard should be reachable on the local network.
DASH_HOST=127.0.0.1
DASH_PORT=8050
DASH_DEBUG=false

# Generate unique values during local setup. Never commit real values.
AUTH_ENABLED=true
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-url-safe-base64-encoded-32-byte-key

# Demo mode: clear dashboard-created requests/actions/auth logs at start and exit.
DB_RESET_ON_EXIT=true
